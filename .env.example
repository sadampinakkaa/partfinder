# ==============================================================================
# PartFinder - Production Environment Configuration
# Dedicated Port: 3001 (Store Analytics runs on Port 3000)
# ==============================================================================

# Server Environment
PORT=3001
NODE_ENV=production

# Shopify App Credentials (from Shopify Partner Dashboard > Product Fit Finder by Pinakkaa)
SHOPIFY_API_KEY=5ec5b77b080f4bb0370b32a2630f9ec3
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Public Production URL (Must be HTTPS)
# Example: https://partfinder.yourdomain.com
SHOPIFY_APP_URL=https://partfinder.yourdomain.com

# Scopes (must match shopify.app.product-fit-finder-by-pinakkaa.toml)
SCOPES=write_products,read_products,read_themes

# Database Configuration (SQLite)
DATABASE_URL=file:./dev.sqlite

# Optional: Custom Shop Domain (leave commented unless using a custom domain)
# SHOP_CUSTOM_DOMAIN=
